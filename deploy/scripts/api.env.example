ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
Database__UseInMemory=false
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=pacarent;Username=pacarent;Password=CHANGE_ME
Jwt__Secret=REPLACE_WITH_VAULT_SECRET_MIN_32_CHARS
PacaRent__DocumentEncryptionKey=REPLACE_WITH_32_PLUS_CHAR_KEY
PacaRent__DocumentStoragePath=/var/lib/pacarent/documents
PacaRent__SkipRegistrationOtp=true
PacaRent__SkipBookingPayment=true
# DOKU Checkout Non-SNAP — sama pola credential dnPeople (DOKU_CLIENT_ID / DOKU_SECRET_KEY)
Doku__UseSandboxMock=false
Doku__IsProduction=false
Doku__ClientId=
Doku__SecretKey=
Doku__ApiPublicUrl=https://api.pacarent.dntech.id
Doku__NotificationUrl=https://api.pacarent.dntech.id/api/payments/webhook/doku
Doku__WebCallbackUrl=https://YOUR_VERCEL_DOMAIN/bookings
# Kosongkan PaymentMethodTypes agar channel mengikuti DOKU Back Office (recommended)
# Doku__PaymentMethodTypes=QRIS
Smtp__UseMock=false
Smtp__Host=
Smtp__Port=587
Smtp__From=noreply@yourdomain.com
Smtp__User=
Smtp__Password=
